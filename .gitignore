# secrets — never commit live keys
.env
.env.*
!.env.example
*.pem
*.p12
*.key
credentials.json
secrets/

# clinical dumps / local uploads — never commit PHI or large archives
*.zip
*.7z
*.rar
*.tar
*.tar.gz
*.tgz
ECW_*
/input/
/output/
/extracted/
labels.csv
manifest.jsonl

# generated installers (may embed live API keys)
/dist/
*.exe
*.msi
*.pkg
Clinical-Note-Labeller-*

# official Docker Desktop installers — too large for git (~600 MB each)
*.dmg
*.iso
*.part
/installer/docker/*.exe
/installer/docker/*.dmg
/installer/docker/*.part

# python
__pycache__/
*.py[cod]
*$py.class
*.egg
*.egg-info/
.eggs/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.migration_check.db
*.sqlite3
celerybeat-schedule
celerybeat.pid

# node
node_modules/
/frontend/dist/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.vite/
.turbo/
coverage/

# runtime / local data
# Anchored to the repository root: an unanchored "workspace/" also matches
# backend/app/workspace/, which silently excluded a source package.
/data/
/workspace/
/logs/
*.log

# test / e2e artifacts
playwright-report/
test-results/

# os / editor
.DS_Store
Thumbs.db
Desktop.ini
.AppleDouble
.LSOverride
.idea/
.vscode/
.cursor/
.claude/
*.swp
*~
*.orig
*.rej
*.bak
*.tmp
*.temp

# docker
docker-compose.override.yml
